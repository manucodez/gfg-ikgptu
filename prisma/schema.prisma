generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // No `url` here — Prisma 7 moved connection config to
  // prisma.config.ts (for the CLI) and to the adapter passed into
  // `new PrismaClient({ adapter })` (for the app) — see lib/prisma.ts.
}

// Mirrors lib/types.ts's Member, minus the nested `socials` object,
// which is flattened into socialGithub/socialLinkedin/socialEmail/
// socialPortfolio columns here — lib/content-store.ts maps between
// the two shapes, so nothing outside that file ever sees the
// difference. IDs are supplied by the API routes (e.g. "m-abc123"),
// not generated by the database.
model Member {
  id              String   @id
  name            String
  role            String
  team            String
  year            String
  branch          String
  bio             String
  skills          String[]
  avatar          String?
  socialGithub    String?
  socialLinkedin  String?
  socialEmail     String?
  socialPortfolio String?
  createdAt       DateTime @default(now())

  credential     MemberCredential?
  changeRequests MemberChangeRequest[]
  otpRequests    OtpRequest[]
  loginEvents    LoginEvent[]

  @@map("members")
}

// Mirrors lib/types.ts's ChapterEvent. Model is named ChapterEvent
// (not Event) purely to avoid colliding with the DOM's global Event
// type in generated Prisma Client code.
model ChapterEvent {
  id               String   @id
  title            String
  date             String
  location         String
  description      String
  status           String
  tags             String[]
  registrationUrl  String?
  notifyOnHomepage Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("events")
}

// Mirrors lib/types.ts's GalleryItem.
model GalleryItem {
  id          String   @id
  caption     String
  category    String
  description String?
  image       String?
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

// Mirrors lib/types.ts's Achievement.
model Achievement {
  id          String @id
  title       String
  description String
  date        String

  @@map("achievements")
}

// Mirrors lib/types.ts's StatItem (the "Active Members" / "Events
// Hosted" style counters on the homepage).
model StatItem {
  id        String   @id
  label     String
  value     Int
  suffix    String?
  createdAt DateTime @default(now())

  @@map("stats")
}

// Mirrors lib/types.ts's MemberCredential. Deliberately its own
// table rather than columns on Member — see the comment on
// MemberCredential in lib/types.ts for why.
model MemberCredential {
  memberId          String   @id
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_credentials")
}

// Mirrors lib/types.ts's MemberChangeRequest. `changes`/`previous`/
// `emailChange` stay as JSON columns rather than fully-normalized
// columns, since their shape is "whatever subset of editable member
// fields changed" — exactly what they are in the JSON-file version.
model MemberChangeRequest {
  id          String    @id
  memberId    String
  memberName  String
  submittedAt DateTime  @default(now())
  status      String
  resolvedAt  DateTime?
  kind        String    @default("profile")
  changes     Json
  previous    Json
  emailChange Json?
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_change_requests")
}

// Mirrors lib/types.ts's OtpRequest. Keyed by email (not id) to
// match the original "one active code per email" invariant.
model OtpRequest {
  email     String   @id
  memberId  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("otp_requests")
}

// Mirrors lib/types.ts's JoinRequest — a submission from the public
// "Join" form (components/contact/contact-section.tsx). Deliberately
// its own table, unconnected to Member: someone filling this out
// isn't a chapter member yet, and an admin reviewing it follows up
// by email rather than it auto-creating a Member record.
model JoinRequest {
  id          String   @id
  name        String
  email       String
  branch      String
  year        String
  message     String?
  /** Cloudinary URL of an uploaded resume/CV, if the person attached
   *  one — raw file upload (not an image), see lib/cloudinary.ts. */
  resumeUrl   String?
  submittedAt DateTime @default(now())
  status      String   @default("new")

  @@map("join_requests")
}

// A record of each successful member login, powering the admin
// dashboard's Activity tab (lib/content-store.ts's addLoginEvent /
// getRecentLoginEvents). Auto-generated id, unlike most other models
// here, since nothing ever needs to reference a specific login event
// by a caller-supplied id — it's purely an append-only log.
model LoginEvent {
  id         String   @id @default(cuid())
  memberId   String
  memberName String
  loggedInAt DateTime @default(now())
  userAgent  String?
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("login_events")
}
