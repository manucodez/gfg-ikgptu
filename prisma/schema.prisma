generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // No `url` here — Prisma 7 moved connection config to
  // prisma.config.ts (for the CLI) and to the adapter passed into
  // `new PrismaClient({ adapter })` (for the app) — see lib/prisma.ts.
}

// Mirrors lib/types.ts's Member, minus the nested `socials` object,
// which is flattened into socialGithub/socialLinkedin/socialEmail/
// socialPortfolio columns here — lib/content-store.ts maps between
// the two shapes, so nothing outside that file ever sees the
// difference. IDs are supplied by the API routes (e.g. "m-abc123"),
// not generated by the database.
model Member {
  id              String   @id
  name            String
  role            String
  team            String
  year            String
  branch          String
  bio             String
  skills          String[]
  avatar          String?
  socialGithub    String?
  socialLinkedin  String?
  socialEmail     String?
  socialPortfolio String?
  /** Optional Codeforces handle — if set, the member's profile shows a
   *  live rating badge fetched from Codeforces' public API (see
   *  lib/codeforces.ts). Free-text, not validated against Codeforces
   *  at save time: an admin/member can set it before ever competing,
   *  and a not-found handle just quietly shows no badge rather than
   *  blocking the save. */
  codeforcesHandle String?
  createdAt       DateTime @default(now())
  /** Admin-controlled display order (drag-and-drop reordering in the
   *  dashboard). Defaults to 0 for every existing row, which — paired
   *  with the createdAt tiebreaker in getMembers() — means nothing
   *  visually changes until an admin actually reorders something. */
  sortOrder       Int      @default(0)

  credential     MemberCredential?
  changeRequests MemberChangeRequest[]
  otpRequests    OtpRequest[]
  loginEvents    LoginEvent[]

  @@map("members")
}

// Mirrors lib/types.ts's ChapterEvent. Model is named ChapterEvent
// (not Event) purely to avoid colliding with the DOM's global Event
// type in generated Prisma Client code.
model ChapterEvent {
  id               String   @id
  title            String
  date             String
  location         String
  description      String
  status           String
  tags             String[]
  registrationUrl  String?
  notifyOnHomepage Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("events")
}

// Mirrors lib/types.ts's GalleryItem.
model GalleryItem {
  id          String   @id
  caption     String
  category    String
  description String?
  image       String?
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

// Mirrors lib/types.ts's Achievement.
model Achievement {
  id          String @id
  title       String
  description String
  date        String

  @@map("achievements")
}

// Mirrors lib/types.ts's StatItem (the "Active Members" / "Events
// Hosted" style counters on the homepage).
model StatItem {
  id        String   @id
  label     String
  value     Int
  suffix    String?
  createdAt DateTime @default(now())

  @@map("stats")
}

// A named admin account (own email + password), so multiple people
// can each sign in to /admin independently instead of sharing one
// login. This is additive: the legacy single-admin env-var login
// (ADMIN_EMAIL + ADMIN_PASSWORD_HASH_B64, checked in
// app/api/admin/login/route.ts) still works as a break-glass fallback
// — useful for creating the very first row here, and as a recovery
// path if the database is ever unreachable. See lib/types.ts's Admin
// for field docs.
model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /** "owner" can create/delete admin accounts and change roles;
   *  "admin" has full content-management access (members, events,
   *  gallery, etc.) but can't manage other admins. Every admin created
   *  before this column existed defaults to "admin" here — the very
   *  first admin ever created (when the admins table is empty) is
   *  always forced to "owner" by the API route regardless of what's
   *  requested, so there's never a chapter site with zero owners. The
   *  legacy env-var bootstrap login (see app/api/admin/login/route.ts)
   *  is always treated as "owner" in code, without needing a row here.
   */
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  @@map("admins")
}

// Mirrors lib/types.ts's MemberCredential. Deliberately its own
// table rather than columns on Member — see the comment on
// MemberCredential in lib/types.ts for why.
model MemberCredential {
  memberId          String   @id
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_credentials")
}

// Mirrors lib/types.ts's MemberChangeRequest. `changes`/`previous`/
// `emailChange` stay as JSON columns rather than fully-normalized
// columns, since their shape is "whatever subset of editable member
// fields changed" — exactly what they are in the JSON-file version.
model MemberChangeRequest {
  id          String    @id
  memberId    String
  memberName  String
  submittedAt DateTime  @default(now())
  status      String
  resolvedAt  DateTime?
  kind        String    @default("profile")
  changes     Json
  previous    Json
  emailChange Json?
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_change_requests")
}

// Mirrors lib/types.ts's OtpRequest. Keyed by email (not id) to
// match the original "one active code per email" invariant.
model OtpRequest {
  email     String   @id
  memberId  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("otp_requests")
}

// Mirrors lib/types.ts's JoinRequest — a submission from the public
// "Join" form (components/contact/contact-section.tsx). Deliberately
// its own table, unconnected to Member: someone filling this out
// isn't a chapter member yet, and an admin reviewing it follows up
// by email rather than it auto-creating a Member record.
model JoinRequest {
  id          String   @id
  name        String
  email       String
  branch      String
  year        String
  message     String?
  /** Cloudinary URL of an uploaded resume/CV, if the person attached
   *  one — raw file upload (not an image), see lib/cloudinary.ts. */
  resumeUrl   String?
  submittedAt DateTime @default(now())
  status      String   @default("new")

  @@map("join_requests")
}

// A record of each successful member login, powering the admin
// dashboard's Activity tab (lib/content-store.ts's addLoginEvent /
// getRecentLoginEvents). Auto-generated id, unlike most other models
// here, since nothing ever needs to reference a specific login event
// by a caller-supplied id — it's purely an append-only log.
model LoginEvent {
  id         String   @id @default(cuid())
  memberId   String
  memberName String
  loggedInAt DateTime @default(now())
  userAgent  String?
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("login_events")
}

// Anonymous, aggregate daily page-view counters — powers the admin
// dashboard's Overview tab. Deliberately NOT per-visitor: no cookie,
// no IP, no session id is stored, just "path X was viewed N times on
// date Y" — consistent with this app's existing privacy stance (see
// the comment on LoginEvent not tracking IP addresses). Incremented
// via POST /api/track, called once per page load by
// components/analytics/page-view-tracker.tsx.
model PageView {
  id    String @id @default(cuid())
  /** YYYY-MM-DD, always computed server-side from the request time —
   *  never trust a client-supplied date for this. */
  date  String
  path  String
  count Int    @default(0)

  @@unique([date, path])
  @@map("page_views")
}
