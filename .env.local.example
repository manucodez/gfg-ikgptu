# Copy this file to .env.local and fill in real values before running
# the app. .env.local is already gitignored — never commit real secrets.

# Long random string used to sign login session cookies (member + admin).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=2996e92060c87ea9a29c6c547326fd1c121032e80dcff0bc44827f1c71d7d900

# Admin login credentials. There is no admin database table on purpose —
# a small chapter site only needs one or two admins, so credentials live
# here as environment variables instead.
#
# ADMIN_PASSWORD_HASH_B64 is a bcrypt hash, base64-encoded. It must stay
# base64-encoded — Next.js's env-file loader treats a raw bcrypt hash's
# $-prefixed segments (e.g. $2a$10$...) as variable references and
# silently corrupts them, which breaks admin login in a confusing way.
# Generate a new one with: npm run hash-password -- "your-new-password"
ADMIN_EMAIL=admin@gfg-ikgptu.org
ADMIN_PASSWORD_HASH_B64=JDJhJDEwJHd0NnpyeVEvVzR4N1VLd0RBZG96MS52RWRocU4zb21JOElKLzVYQnVDQi9Nc1o2cFIzT09P

# Postgres connection string, from a Neon project's Connect panel
# (https://neon.tech, free tier). Specifically Neon, not "any provider" —
# lib/prisma.ts connects via Neon's serverless driver adapter
# (@prisma/adapter-neon), not a generic Postgres connection, since that's
# what actually works well from serverless hosts like Vercel/Netlify. The
# `connect_timeout=15` guards against Neon's free-tier databases scaling to
# zero when idle — without it, the first query after a idle period can
# time out before the database finishes waking up. After setting this, run:
#   npx prisma migrate dev --name init
#   npm run db:seed          (loads your existing content/*.json)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&connect_timeout=15

# Cloudinary account for member avatars and gallery photo uploads —
# free tier is plenty for a chapter site. Get these three values from
# your Cloudinary dashboard at https://cloudinary.com/console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP sends the real "forgot / set password" verification code
# email. Without both vars set, the app falls back to printing the
# code to the server console instead — fine for local dev, not for
# anyone actually using the site.
#   1. Turn on 2-Step Verification for the Gmail account you want to
#      send from, at myaccount.google.com/security (required — Gmail
#      SMTP won't accept your regular password even if you skip this,
#      it'll just fail).
#   2. Generate an App Password at myaccount.google.com/apppasswords
#      (choose "Mail" as the app). Google gives you a 16-character
#      password — copy it below exactly, spaces removed or not both
#      work.
#   3. GMAIL_USER is the full Gmail address itself.
# Note: a regular Gmail account tops out at 500 emails/day, which is
# plenty for a chapter site's OTP volume but worth knowing if the
# chapter ever grows a lot. Mail from a personal Gmail address can also
# land in spam more often than a dedicated transactional sender would
# — if that becomes a real problem later, a service like Resend can
# swap in here with the same two-function interface (see lib/mailer.ts).
GMAIL_USER=
GMAIL_APP_PASSWORD=
